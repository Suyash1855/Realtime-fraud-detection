# Copy to .env and replace every value before deploying anywhere.
# docker compose reads .env automatically; the compose file fails to start if a
# required variable is missing rather than falling back to a default.

# Redis — consumer writes predictions here, the API reads them
REDIS_PASSWORD=change-me-redis

# MLflow backend store
POSTGRES_PASSWORD=change-me-postgres

# MLflow artifact store
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Fraud API — required on every endpoint except /health and /metrics
API_KEY=change-me-api-key

# Address clients outside the docker network use to reach Kafka. "localhost" is
# correct only when those clients run on the docker host; set it to the host's
# reachable name or IP otherwise, or external producers get metadata pointing
# at themselves.
KAFKA_ADVERTISED_HOST=localhost

# Interface the infrastructure ports bind to. 127.0.0.1 keeps Kafka, Redis,
# Postgres, MinIO, Grafana, Prometheus and the Kafka UI off the network; only
# the fraud API is published. Use 0.0.0.0 only behind a firewall.
BIND_ADDRESS=127.0.0.1

# ─── Deployment only (docker-compose.prod.yml) ───────────────────────────────
# Unset locally; required on the server. Caddy serves api.$DOMAIN and
# grafana.$DOMAIN, so both need A records pointing at the host before the first
# start — Let's Encrypt validates over HTTP and a missing record fails the
# certificate order.
DOMAIN=example.com
ACME_EMAIL=you@example.com

# Interface the read API binds to. Empty/unset means 0.0.0.0, which is right for
# local use. Set it to 127.0.0.1 behind Caddy so port 8200 is not a second,
# plaintext way into the same API.
API_BIND_ADDRESS=0.0.0.0
