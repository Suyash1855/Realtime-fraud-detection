# ── Data (1.3 GB of Kaggle CSVs — never commit) ──────────────────────────────
data/
*.csv

# ── MLflow local stores ──────────────────────────────────────────────────────
mlruns/
mlartifacts/

# ── Generated model artifacts ────────────────────────────────────────────────
# Local scratch copies of the train/serve contract. Nothing deploys from here:
# consumer.py and scripts/export_for_deploy.py both download it from the MLflow
# run that produced the model, so the tracked copy is deploy_bundle/.
artifacts/*.json

# ── Plots / reports ──────────────────────────────────────────────────────────
*.png
!docs/*.png

# ── Node / frontend build ────────────────────────────────────────────────────
node_modules/
web/dist/

# ── Claude local machine config (absolute paths, not portable) ───────────────
.claude/settings.local.json

# ── Stray tool-call artifact ─────────────────────────────────────────────────
LAYER_DATA*

# ── Private working notes (kept local, not published) ────────────────────────
RESUME_BRIEF.md

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ipynb_checkpoints/

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp

# ── Secrets / local overrides ────────────────────────────────────────────────
.env
.env.local
